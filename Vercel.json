{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/google2934fc7ddf78d66c.html",
      "dest": "static/google2934fc7ddf78d66c.html"
    },
    {
      "src": "/robots.txt",
      "dest": "static/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "static/sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
