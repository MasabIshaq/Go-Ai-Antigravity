{
  "appId": "com.goprojects.goai",
  "appName": "Go Ai",
  "webDir": "static",
  "server": {
    "url": "https://go-ai-official.vercel.app",
    "cleartext": true,
    "errorPath": "error.html"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#212121",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
